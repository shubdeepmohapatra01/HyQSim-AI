# Copy this file to .env and fill in whichever keys you have.
# Any key set here becomes available as "server key" in the UI —
# users of the app won't need to enter their own keys.
#
# You only need ONE key. The UI will show a green "Server key available" banner.

# Anthropic — get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — get a key at platform.openai.com
OPENAI_API_KEY=

# Groq — free tier available at console.groq.com (no credit card required)
GROQ_API_KEY=

# Google Gemini — free tier available at aistudio.google.com
GOOGLE_API_KEY=

# Mistral — get a key at console.mistral.ai
MISTRAL_API_KEY=

# Together AI — get a key at api.together.xyz
TOGETHER_API_KEY=

# ─── Proxy protection ────────────────────────────────────────────────────────
# /ai/chat spends the keys above on a caller-controlled request body. Leave these
# unset for local development; SET AI_PROXY_TOKEN for any deployment reachable
# from the internet, or anyone who can reach the backend can spend your credits.
#
# The frontend sends it as VITE_AI_PROXY_TOKEN (set in frontend/.env).
AI_PROXY_TOKEN=

# Per-IP request cap for /ai/chat, per minute. Default 20.
AI_RATE_LIMIT_PER_MIN=20
